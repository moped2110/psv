CLAUDE.md
AGENTS.md
# Personal quick-start with local machine paths — public guide is docs/SETUP-onchain.md
START-HERE.md
# Private working backlog — do not commit (run once: git rm --cached TODO.md)
TODO.md
TODO-*.md
# Internal strategy / raw test-idea analysis — sanitize before any public push
docs/source-testcases.md
docs/system-test-catalog.md

# Foundry
onchain/out/
onchain/cache/
onchain/broadcast/

# Anvil state dumps
*.anvil
anvil-state.json
.coverage

# Default run-record directory (audit trail of runs) — machine-local, not tracked.
psv-runs/
.smoke/
wheelhouse/

# This project locks through requirements/ci.in -> requirements/ci.txt. A bare
# `uv run` in the repo root creates a uv.lock as a side effect, and committing it
# would leave two competing lock mechanisms where the drift guard only watches one.
uv.lock
