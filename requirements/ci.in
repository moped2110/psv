# Direct CI inputs. Regenerate the hashed lock after dependency changes:
#   uv pip compile --universal --python-version 3.11 --generate-hashes \
#     --no-annotate -o requirements/ci.txt requirements/ci.in
#
# The lock must resolve for the LOWEST version in the CI matrix and carry markers
# for the rest. A lock compiled on 3.12 silently omits dependencies that only
# apply below it (jaraco-context pulls backports.tarfile on < 3.12), and
# --require-hashes then fails on 3.11 with "must have their versions pinned".
pytest>=8.0
pytest-cov>=5.0
mypy>=2.3.1
ruff>=0.16.4
hypothesis>=6.165.10
jsonschema>=4.23
httpx>=0.27
web3>=7.0
eth-account>=0.14.0
fastapi>=0.110
uvicorn>=0.52.4
build>=1.2
hatchling>=1.27
# Hatchling imports `editables` only when building an editable wheel, so a
# resolver never sees it. CI installs the package with `pip install -e .`, which
# fails with ModuleNotFoundError unless it is requested explicitly.
editables>=0.5
twine>=5.1
pip-audit>=2.7
# Needed by the lock-drift guard in ci.yml, which regenerates this lock and diffs
# it. Locking the resolver itself keeps that check reproducible.
uv>=0.12.6
# The MCP SDK, so the strict type check sees its types and the MCP server's tests
# actually run. Without it `pytest.importorskip("mcp")` skips them into silence.
mcp>=2.1.1
# Security floors for transitive dependencies. Neither is requested directly:
# cryptography arrives via mcp, aiohttp via web3. `pip-audit --strict` fails the
# supply-chain job while either is at a known-vulnerable version, so the floor is
# what keeps that gate honest. Floors rather than pins — the resolver may go higher.
cryptography>=50.0.1  # PYSEC-2026-3552
aiohttp>=3.14.3       # PYSEC-2026-3545 / -3546 / -3547
